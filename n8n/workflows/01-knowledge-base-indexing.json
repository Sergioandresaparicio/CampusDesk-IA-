{
  "name": "CampusDesk - 01 Indexacion Base de Conocimiento (Qdrant)",
  "nodes": [
    {
      "parameters": {},
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [220, 180],
      "id": "10000000-0000-4000-8000-000000000001",
      "name": "Manual Trigger"
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [220, 340],
      "id": "10000000-0000-4000-8000-000000000002",
      "name": "Schedule Sync (15m)"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "campusdesk-kb-sync",
        "responseMode": "onReceived",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [220, 500],
      "id": "10000000-0000-4000-8000-000000000003",
      "name": "Webhook: Sync KB",
      "webhookId": "campusdesk-kb-sync-webhook"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ ($env.QDRANT_URL || 'http://qdrant:6333').replace(/\\/$/, '') + '/collections/' + ($env.QDRANT_COLLECTION || 'campusdesk_kb') }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 340],
      "id": "10000000-0000-4000-8000-000000000004",
      "name": "Check Qdrant Collection",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "={{ ($env.QDRANT_URL || 'http://qdrant:6333').replace(/\\/$/, '') + '/collections/' + ($env.QDRANT_COLLECTION || 'campusdesk_kb') }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ vectors: { size: Number($env.QDRANT_VECTOR_SIZE || 1536), distance: 'Cosine' } }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 480],
      "id": "10000000-0000-4000-8000-000000000005",
      "name": "Create Qdrant Collection"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ ($env.BACKEND_BASE_URL || 'http://backend:8051').replace(/\\/$/, '') + '/api/v1/integrations/n8n/data' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-Api-Key",
              "value": "={{ $env.N8N_API_KEY || 'campusdesk-n8n-m2m-secret-key-2026' }}"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [940, 340],
      "id": "10000000-0000-4000-8000-000000000006",
      "name": "Fetch KB Articles from Spring Boot"
    },
    {
      "parameters": {
        "jsCode": "const fetched = $input.first().json;\nconst articles = Array.isArray(fetched?.data?.articlesForIndexing)\n  ? fetched.data.articlesForIndexing\n  : [];\n\nif (articles.length === 0) {\n  return [];\n}\n\nreturn articles.map(article => {\n  const textToEmbed = [\n    `Título: ${article.title || ''}`,\n    `Categoría: ${article.category || ''}`,\n    `Problema: ${article.problem || ''}`,\n    article.symptoms ? `Síntomas: ${article.symptoms}` : '',\n    article.cause ? `Causa raíz: ${article.cause}` : '',\n    `Solución: ${article.solution || ''}`\n  ].filter(Boolean).join('\\n');\n\n  return {\n    json: {\n      articleId: Number(article.id),\n      title: article.title || '',\n      category: article.category || 'OTROS',\n      problem: article.problem || '',\n      symptoms: article.symptoms || '',\n      cause: article.cause || '',\n      solution: article.solution || '',\n      active: Boolean(article.active),\n      verified: Boolean(article.verified),\n      textToEmbed\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1180, 220],
      "id": "10000000-0000-4000-8000-000000000007",
      "name": "Prepare Articles for Embedding"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/embeddings",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + ($env.OPENROUTER_API_KEY || '') }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "HTTP-Referer",
              "value": "http://localhost:8051"
            },
            {
              "name": "X-Title",
              "value": "CampusDesk-IA"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $env.OPENROUTER_EMBEDDING_MODEL || 'openai/text-embedding-3-small', input: $json.textToEmbed }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1420, 220],
      "id": "10000000-0000-4000-8000-000000000008",
      "name": "Generate Article Embedding (OpenRouter)",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "parameters": {
        "jsCode": "const embeddingItems = $input.all();\nconst articleItems = $('Prepare Articles for Embedding').all();\nconst points = [];\n\nfor (let i = 0; i < embeddingItems.length; i++) {\n  const article = articleItems[i]?.json;\n  const vector = embeddingItems[i]?.json?.data?.[0]?.embedding;\n  if (!article || !Array.isArray(vector) || vector.length === 0) {\n    throw new Error(`No se recibió un embedding válido para el artículo ${article?.articleId ?? i}`);\n  }\n  points.push({\n    id: article.articleId,\n    vector,\n    payload: {\n      articleId: article.articleId,\n      title: article.title,\n      category: article.category,\n      problem: article.problem,\n      symptoms: article.symptoms,\n      cause: article.cause,\n      solution: article.solution,\n      active: article.active,\n      verified: article.verified,\n      indexedAt: new Date().toISOString()\n    }\n  });\n}\n\nif (points.length === 0) {\n  return [];\n}\n\nreturn [{ json: { points, indexedCount: points.length } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1660, 220],
      "id": "10000000-0000-4000-8000-000000000009",
      "name": "Build Qdrant Points Batch"
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "={{ ($env.QDRANT_URL || 'http://qdrant:6333').replace(/\\/$/, '') + '/collections/' + ($env.QDRANT_COLLECTION || 'campusdesk_kb') + '/points?wait=true' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ points: $json.points }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1900, 220],
      "id": "10000000-0000-4000-8000-000000000010",
      "name": "Upsert Points to Qdrant"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.QDRANT_URL || 'http://qdrant:6333').replace(/\\/$/, '') + '/collections/' + ($env.QDRANT_COLLECTION || 'campusdesk_kb') + '/points/scroll' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{ \"limit\": 1000, \"with_payload\": false, \"with_vector\": false }",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1180, 480],
      "id": "10000000-0000-4000-8000-000000000011",
      "name": "Scroll Qdrant Points"
    },
    {
      "parameters": {
        "jsCode": "const fetched = $('Fetch KB Articles from Spring Boot').first().json;\nconst articles = Array.isArray(fetched?.data?.articlesForIndexing)\n  ? fetched.data.articlesForIndexing\n  : [];\nconst activeIds = new Set(articles.map(a => Number(a.id)));\n\nconst qdrantPoints = $input.first().json?.result?.points || [];\nconst staleIds = qdrantPoints\n  .map(p => Number(p.id))\n  .filter(id => Number.isFinite(id) && !activeIds.has(id));\n\nreturn [{\n  json: {\n    staleIds,\n    staleCount: staleIds.length,\n    hasStale: String(staleIds.length > 0)\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1420, 480],
      "id": "10000000-0000-4000-8000-000000000012",
      "name": "Find Stale Qdrant IDs"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-has-stale",
              "leftValue": "={{ $json.hasStale }}",
              "rightValue": "true",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1660, 480],
      "id": "10000000-0000-4000-8000-000000000013",
      "name": "Has Stale Points?"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.QDRANT_URL || 'http://qdrant:6333').replace(/\\/$/, '') + '/collections/' + ($env.QDRANT_COLLECTION || 'campusdesk_kb') + '/points/delete?wait=true' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ points: $json.staleIds }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1900, 460],
      "id": "10000000-0000-4000-8000-000000000014",
      "name": "Delete Stale Qdrant Points"
    }
  ],
