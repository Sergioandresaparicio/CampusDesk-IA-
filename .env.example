# ===================================================================
# CampusDesk IA - Environment Variables Template
# Copy this file to .env and fill in your real credentials before
# running: docker compose up -d --build
# ===================================================================

# --- PostgreSQL (Relational DB) ---
POSTGRES_DB=campusdesk
DB_USERNAME=campusdesk
DB_PASSWORD=campusdesk_change_me
# Used by backend inside Docker Compose:
DB_URL=jdbc:postgresql://postgres:5432/campusdesk
DB_DRIVER=org.postgresql.Driver

# --- Spring Boot Backend ---
SERVER_PORT=8051
JWT_SECRET=replace-with-a-secure-random-64-char-hex-secret-key-for-production
JWT_ISSUER=campusdesk-auth-issuer
JWT_EXPIRATION=15d
BOOTSTRAP_ADMIN_ENABLED=true
ADMIN_USERNAME=superadmin
ADMIN_EMAIL=superadmin@campusdesk.edu
ADMIN_PASSWORD=SuperAdmin123!

# --- n8n & Machine-to-Machine (M2M) Security ---
# Note: When running Spring Boot inside Docker, N8N_WEBHOOK_URL uses service name "n8n".
# If running Spring Boot on host outside Docker, use http://localhost:5678/webhook/campusdesk-incident
N8N_WEBHOOK_URL=http://n8n:5678/webhook/campusdesk-incident
N8N_API_KEY=campusdesk-n8n-m2m-secret-key-2026
# Used by n8n workflows to reach Spring Boot inside Docker (or http://host.docker.internal:8051 if backend runs on host)
BACKEND_BASE_URL=http://backend:8051
N8N_HOST=localhost
N8N_PORT=5678
N8N_WEBHOOK_PUBLIC_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=replace-with-random-32-char-n8n-encryption-key
GENERIC_TIMEZONE=America/Bogota

# --- Qdrant Vector Database ---
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=campusdesk_kb
# Cosine similarity threshold (0.0 - 1.0). Recommended baseline: 0.70
QDRANT_SCORE_THRESHOLD=0.70
# Vector dimension matching OPENROUTER_EMBEDDING_MODEL (1536 for openai/text-embedding-3-small)
QDRANT_VECTOR_SIZE=1536

# --- OpenRouter AI Models ---
OPENROUTER_API_KEY=sk-or-v1-replace-with-your-openrouter-api-key
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
